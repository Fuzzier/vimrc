{
  // Automatically update 'b:coc_current_function'.
  "coc.preferences.extensionUpdateCheck": "daily",

  ////////////////////
  // coc-codeLens
  "codeLens.enable": false,

  ////////////////////
  // coc-colors
  "colors.enable": false,

  ////////////////////
  // coc-suggest
  // The style of tghe popup menu and documentation window for completion.
  "suggest.floatConfig": {
    "border": false,
    "borderhighlight": "NonText"
  },
  // The maximum number of completion items shown.
  "suggest.maxCompleteItemCount": 32,
  // The indicator that shows a complete item can be expanded as a snippet.
  "suggest.snippetIndicator": "🐼✨",

  ////////////////////
  // coc-diagnostic
  "diagnostic.enableSign": true,
  "diagnostic.errorSign": "E",
  "diagnostic.warningSign": "W",
  "diagnostic.infoSign": "I",
  "diagnostic.hintSign": "H",
  "diagnostic.messageTarget": "float",

  ////////////////////
  // coc-inlayHint
  "inlayHint.enable": true,
  "inlayHint.display": false,
  "inlayHint.enableParameter": true,
  "inlayHint.position": "inline",

  ////////////////////
  // coc-signature
  "signature.enable": false,
  // Show signature in float.
  "signature.target": "float",

  ////////////////////
  // coc-json
  // The trailing comma error hurts the eyes...
  "json.validate.enable": false,

  ////////////////////
  // language servers
  "languageserver": {
    "ccls": {
      "enable": false,
      "command": "ccls",
      // "args": [ "--log-file=Z:/ccls.log", "-v=1" ],
      "filetypes": [ "c", "cpp", "cuda", "objc", "objcpp" ],
      "rootPatterns": [ ".ccls-root", "compile_commands.json" ],
      "requireRootPattern": true,
      "initializationOptions": {
        "cache": {
          "directory": ".ccls-cache",
          "retainInMemory": 1,
        },
        "client": {
          // Effect: add parenthesis for functions automatically.
          "snippetSupport": true,
        },
        "completion": {
          "placeholder": false,
          "filterAndSort": false,
          "detailedLabel": false,
        },
        "highlight": {
          "lsRanges": true,
        },
        // "clang": {
        //   "extraArgs": [
        //     "-I..",
        //     "-std=c++17"
        //   ]
        // }
      },
    },
    "clangd": {
      "enable": true,
      "command": "clangd",
      "filetypes": [
        "c",
        "cpp",
        "cuda",
        "objc",
        "objcpp",
      ],
      "rootPatterns": [
        "compile_commands.json",
        "compile_flags.txt",
      ],
      "args": [
        "--background-index",
      ],
    }
  }
}
